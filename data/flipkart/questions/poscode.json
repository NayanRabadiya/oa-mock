 "type": "code",
 "ref": "import sys, heapq\nfrom collections import defaultdict\n\ndef poscode(s):\n    w=s.split()[0]; srt=sorted(w)\n    q=defaultdict(list)\n    for i,c in enumerate(srt): q[c].append(i)\n    ptr=defaultdict(int); base=ord(srt[-1]); X=0\n    for i,c in enumerate(w):\n        j=q[c][ptr[c]]; ptr[c]+=1\n        X+=sum(map(int,str(abs(i-j)+base)))\n    d=sum(map(int,str(X)))\n    return f\"{X} {chr((d-1)%26+65)}\"\n\nprint(poscode(sys.stdin.read()))\n",
 "refcpp": "#include <bits/stdc++.h>\nusing namespace std;\nint ds(long long v){int s=0; while(v){s+=v%10; v/=10;} return s;}\nint main(){ string w; cin>>w; int n=w.size(); vector<int> idx(n); iota(idx.begin(),idx.end(),0);\n  stable_sort(idx.begin(),idx.end(),[&](int a,int b){return w[a]<w[b];});   // idx[j] = original position of sorted letter j\n  int base=w[idx[n-1]]; long long X=0;\n  for(int j=0;j<n;j++) X+=ds(llabs((long long)idx[j]-j)+base);\n  int d=ds(X); cout<<X<<\" \"<<char('A'+(d-1)%26)<<\"\\n\"; }\n",
 "lc": "1945 Sum of Digits of String After Convert",
